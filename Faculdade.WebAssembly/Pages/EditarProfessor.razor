@page "/professores/editar/{id:int}"
@inject ProfessoresAPI professoresAPI
@inject ILogger<Professores> logger
@using Faculdade.Shared.Data.Dtos.ProfessorDtos
@using Faculdade.WebAssembly.Components
@inject NavigationManager Navigation
@inject IJSRuntime JS

<h3 class="form-title">Editar Professor</h3>

@if (professor is null)
{
	<p>Carregando dados do professor...</p>
}
else
{
    <div class="form-container">
        <EditForm Model="professor" OnValidSubmit="Salvar">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label>Nome</label>
                <InputText class="form-input" @bind-Value="professor.Nome" />
            </div>

            <div class="form-group">
                <label>CPF</label>
                <InputText class="form-input" @bind-Value="professor.Cpf" />
            </div>

            <div class="form-group">
                <label>Telefone</label>
                <InputText class="form-input" @bind-Value="professor.Telefone" />
            </div>

            <div class="form-group">
                <label>E-mail</label>
                <InputText class="form-input" @bind-Value="professor.Email" />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-salvar">
                    Salvar
                </button>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter]
    public int id { get; set; }

    private UpdateProfessorDto? professor;

    protected async override Task OnInitializedAsync()
    {
        try
        {
            logger.LogInformation($"Buscando professor ID {id}");
            professor = await professoresAPI.GetProfessorByIdToUpdate(id);
        }
        catch (Exception e)
        {
            logger.LogError(e, "Erro ao buscar professor");
        }
    }

    private async Task Salvar()
    {
        try
        {
            logger.LogInformation($"Atualizando professor ID {id}.");
            await professoresAPI.UpdateProfessor(id, professor);
            await JS.InvokeVoidAsync(
                "alert",
                "Professor atualizado com sucesso!"
            );
            Navigation.NavigateTo($"/professores");
        }
        catch (Exception e)
        {
            logger.LogError(e, "Erro ao atualizar professor.");
            await JS.InvokeVoidAsync(
                "alert",
                "Erro ao salvar professor"
            );
        } 
    }
}
