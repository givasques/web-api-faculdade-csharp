@using Faculdade.Shared.Data.Dtos.AlunoDtos
@inject NavigationManager Navigation

<div class="card-person">
    <div class="card-person__info">
        <img class="card-person__image" src="images/perfil.png" alt="Imagem de perfil">
        <div class="card-person__info__data">
            <p>RM @Aluno.Rm</p>
            <p>@Aluno.Nome (@Aluno.IdTurma)</p>
            <p>CPF: @Aluno.Cpf</p>
            <p>Email: @Aluno.Email</p>
            <p>Data de Nascimento: @Aluno.DataNascimento</p>
        </div>
    </div>
    <button class="card-person__btn" @onclick="EditarAluno">Editar</button>
</div>

@code {
    [Parameter]
    public ReadAlunoDto Aluno { get; set; } = default!;

    private void EditarAluno()
    {
        Navigation.NavigateTo($"/alunos/editar/{Aluno.Rm}");
    }
}
 