@using Faculdade.Shared.Data.Dtos.ProfessorDtos
@inject NavigationManager Navigation

<div class="card-person">
    <div class="card-person__info">
        <img class="card-person__image" src="images/perfil.png" alt="Imagem de perfil">
        <div class="card-person__info__data">
            <p class="muted">ID @Professor.Id</p>
            <p class="name">@Professor.Nome</p>
            <p>CPF: @Professor.Cpf</p>
            <p>Telefone: @Professor.Telefone</p>
            <p>Email: @Professor.Email</p>
        </div>
    </div>
    <button class="card-person__btn" @onclick="EditarProfessor">Editar</button>
</div>

@code {
    [Parameter]
    public ReadProfessorDto Professor { get; set; } = default!;

    private void EditarProfessor()
    {
        Navigation.NavigateTo($"/professores/editar/{Professor.Id}");
    }
}